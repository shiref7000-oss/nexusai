# ─── Database ───
DATABASE_URL=mysql://user:password@host:port/database

# ─── OAuth (auto-generated by init) ───
VITE_KIMI_AUTH_URL=https://accounts.kimi.ai/oauth2/auth
VITE_APP_ID=your_app_id
KIMI_APP_SECRET=your_app_secret
JWT_SECRET=your_jwt_secret

# ─── Meta Ads API ───
META_ACCESS_TOKEN=your_meta_access_token
META_AD_ACCOUNT_ID=act_1234567890

# ─── WhatsApp Business API ───
WHATSAPP_ACCESS_TOKEN=your_whatsapp_token
WHATSAPP_PHONE_NUMBER_ID=1234567890
WHATSAPP_WABA_ID=0987654321

# ─── Shipping APIs ───
BOSTA_API_KEY=your_bosta_api_key
ARAMEX_USERNAME=your_aramex_username
ARAMEX_PASSWORD=your_aramex_password
ARAMEX_ACCOUNT=your_account_number
ARAMEX_PIN=your_pin
VHUB_API_KEY=your_vhub_api_key
SMSA_API_KEY=your_smsa_api_key

# ─── AI APIs (Gemini is primary, OpenAI/Anthropic are fallbacks) ───
GEMINI_API_KEY=your_gemini_api_key
AI_DAILY_TOKEN_LIMIT=1000000

OPENAI_API_KEY=sk-your_openai_key
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key
